{
  "name": "@openthrottle/supervisor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "epoch:initialize": "node scripts/initialize-epoch.mjs",
    "epoch:accept-release": "node scripts/accept-release.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@daytona/sdk": "^0.207.0",
    "@hono/node-server": "^2.1.1",
    "@openthrottle/contracts": "file:../contracts",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.5"
  },
  "overrides": {
    "@opentelemetry/propagator-jaeger": "2.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.11",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "yaml": "^2.9.0"
  }
}
