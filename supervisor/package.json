{
  "name": "@openthrottle/supervisor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "docs:pipelines": "tsx scripts/render-pipelines.mjs",
    "verify:v12-deploy-proof": "node scripts/verify-v12-deploy-proof.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@daytona/sdk": "^0.199.0",
    "@hono/node-server": "^2.0.10",
    "@openthrottle/contracts": "file:../contracts",
    "better-sqlite3": "^12.11.1",
    "hono": "^4.12.30",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.4",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
