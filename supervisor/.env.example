# OpenThrottle supervisor — environment variables.
# See docs/SPEC.md "Supervisor contract > Supervisor env" for the authoritative list.
# Copy to .env for local dev (tsx/dotenv is NOT wired in automatically —
# export these into your shell, or use `dotenv -e .env -- npm run dev`).

# --- HTTP / storage ---
PORT=8080
DATABASE_PATH=/data/openthrottle.db
SUPERVISOR_URL=https://openthrottle-supervisor.fly.dev
OT_STATUS_TOKEN=
OT_DEPLOY_TOKEN=
OT_INSTALL_SECRET=

# --- Linear (webhook + OAuth app, actor=app) ---
LINEAR_WEBHOOK_SECRET=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# --- GitHub ---
GITHUB_WEBHOOK_SECRET=
# Fine-grained PAT: administration/webhooks rw, contents rw, PRs rw,
# checks/actions read, with access to every target repository
GITHUB_TOKEN=
# Separate least-privilege sandbox token: contents/PRs/checks/actions read
# only. Actions read is required for CI-failure enrichment (failing jobs and
# log tails); without it those lookups return 403 and enrichment degrades.
# Read-only pipeline stages never receive the write-capable supervisor token.
GITHUB_READ_TOKEN=

# --- Daytona ---
DAYTONA_API_KEY=
DAYTONA_SNAPSHOT=openthrottle
# Sandbox resource sizing, applied when the snapshot is built
# (supervisor/scripts/build-snapshot.mjs). Defaults clear Daytona's small
# default tier, which OOM-kills real pnpm/Turbo monorepo builds (exit 137).
# cpu in cores, memory/disk in GiB. Disk is kept small because Daytona
# enforces a 30 GiB *total* org disk quota and OpenThrottle retains a stopped
# sandbox per non-closed ticket; raise it only on a plan with a larger quota.
DAYTONA_SANDBOX_CPU=4
DAYTONA_SANDBOX_MEMORY=8
DAYTONA_SANDBOX_DISK=5

# --- Agent subscription auth ---
DEFAULT_AGENT=codex
CLAUDE_CODE_OAUTH_TOKEN=
# Raw contents of ~/.codex/auth.json, as a single-line JSON string
CODEX_AUTH_JSON=
# Kimi Code Console subscription API key for OpenCode (not Kimi Open Platform)
KIMI_CODE_API_KEY=

# --- Pipeline runtime ---
# Ordinary stage hard timeout in seconds. Structured composite parents may
# extend to their sealed graph phase timeout, but no deadline may exceed 86400.
TASK_TIMEOUT=7200
ORPHAN_GRACE_MINUTES=5
WEBHOOK_MAX_AGE_SECONDS=60
ALLOW_LINEAR_MERGE=false
SANDBOX_EVENT_POLL_INTERVAL_MS=5000
# Liveness cap (seconds): a running run that emits no sandbox activity for this
# long is reaped (failed + sandbox idled), independent of the hard TASK_TIMEOUT
# wall clock. Must be >= 60; keep it comfortably above the heartbeat interval.
STALL_TIMEOUT_SECONDS=900
# Retention (days) for run_outcomes, the settlement rollup corpus. Kept
# separate from and much longer than the other operational-data cutoffs
# (7 days, hardcoded in operations/sweep.ts) since these rows are
# supervisor-derived facts only, safe to retain for skill-tuning measurement.
RUN_OUTCOME_RETENTION_DAYS=180

# --- Anonymous harness incident reporting (operator opt-in) ---
# off: no enqueue or send; on: receipt plus a lead-authored diagnosis;
# deterministic: receipt only. The diagnosis is made only from the contract's
# closed vocabulary.
HARNESS_REPORTING_MODE=off
# Required only when mode is on or deterministic. This is a private endpoint;
# its backend owns semantic dedupe and any later public issue workflow.
HARNESS_REPORTING_ENDPOINT=https://reports.openthrottle.dev/v1/harness-incidents
HARNESS_REPORTING_TOKEN=
