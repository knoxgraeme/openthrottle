# OpenThrottle supervisor — environment variables.
# See docs/SPEC.md "Supervisor contract > Supervisor env" for the authoritative list.
# Copy to .env for local dev (tsx/dotenv is NOT wired in automatically —
# export these into your shell, or use `dotenv -e .env -- npm run dev`).

# --- HTTP / storage ---
PORT=8080
DATABASE_PATH=/data/openthrottle.db
SUPERVISOR_URL=https://openthrottle-supervisor.fly.dev
OT_STATUS_TOKEN=
OT_INSTALL_SECRET=

# --- Linear (webhook + OAuth app, actor=app) ---
LINEAR_WEBHOOK_SECRET=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# --- GitHub ---
GITHUB_WEBHOOK_SECRET=
# Fine-grained PAT: administration/webhooks rw, contents rw, PRs rw,
# checks/actions read, with access to every target repository
GITHUB_TOKEN=
# Fallback for unmapped/legacy Linear teams. New targets use `openthrottle init`.
GITHUB_REPO=owner/name
# Legacy optional JSON fallback: {"linear-team-id":"owner/repo","TEAM":"owner/repo"}
GITHUB_REPO_MAPPINGS=
# Optional JSON: {"Repo/web-app":"owner/web-app","Repo › Repo/api":"owner/api"}
GITHUB_REPO_LABEL_MAPPINGS=
# Optional git commit-author override for sandbox commits. Leave blank to author
# commits as the GitHub account behind GITHUB_TOKEN (its noreply identity), which
# keeps commits attributable and accepted by author-gated integrations (Vercel).
OT_GIT_AUTHOR_NAME=
OT_GIT_AUTHOR_EMAIL=

# --- Fly Sprites (sandbox provider) ---
# Org-scoped Sprites API token (create at sprites.dev/account or `sprite org auth`).
SPRITE_TOKEN=
# Optional; defaults to https://api.sprites.dev
SPRITES_API_URL=https://api.sprites.dev
# Path to the sandbox payload tarball baked into the supervisor image.
OT_PAYLOAD_TAR_PATH=/app/payload.tar.gz

# --- Agent subscription auth ---
DEFAULT_AGENT=codex
CLAUDE_CODE_OAUTH_TOKEN=
# Raw contents of ~/.codex/auth.json, as a single-line JSON string
CODEX_AUTH_JSON=
# Kimi Code Console subscription API key for OpenCode (not Kimi Open Platform)
KIMI_CODE_API_KEY=

# --- Task defaults ---
# Fallback for unmapped/legacy Linear teams. Registered targets persist their own base branch.
BASE_BRANCH=main
MAX_TURNS=200
TASK_TIMEOUT=7200
CALLBACK_GRACE_SECONDS=120
DEV_PORT=3000
SWEEP_MAX_AGE_DAYS=14
ORPHAN_GRACE_MINUTES=5
WEBHOOK_MAX_AGE_SECONDS=60
REVIEW_MAX_ROUNDS=3
ALLOW_LINEAR_MERGE=false
