# OpenThrottle supervisor — environment variables.
# See docs/SPEC.md "Supervisor contract > Supervisor env" for the authoritative list.
# Copy to .env for local dev (tsx/dotenv is NOT wired in automatically —
# export these into your shell, or use `dotenv -e .env -- npm run dev`).

# --- HTTP / storage ---
PORT=8080
DATABASE_PATH=/data/openthrottle-kernel-v1.sqlite
SUPERVISOR_URL=https://openthrottle-supervisor.fly.dev
OT_STATUS_TOKEN=
OT_DEPLOY_TOKEN=
OT_BLOB_STORE_PATH=/data/openthrottle-kernel-v1-blobs
OT_BLOB_STORE_ID=openthrottle-execution-kernel-v1
OT_EPOCH_RELEASE_ID=openthrottle-execution-kernel/v1
# Exact checksum emitted by the one-shot fresh-epoch initializer.
OT_EPOCH_BOOTSTRAP_CHECKSUM=
# Release root contains contracts/runtime-capabilities.json and generated definitions.
OT_RELEASE_ROOT=/app
OT_GENERATED_DEFINITION_ROOT=/app/contracts/generated

# --- Linear control (optional) ---
# Set all three together to enable Linear agent-session control. The OAuth
# application credentials remain supervisor-only and are never sent to agents.
LINEAR_WEBHOOK_SECRET=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# --- GitHub ---
GITHUB_WEBHOOK_SECRET=
# Fine-grained PAT: administration/webhooks rw, contents rw, PRs rw,
# checks/actions read, with access to every target repository
GITHUB_TOKEN=
# Separate least-privilege token for exact-commit definition reads and sandbox
# repository access. Inspect attempts never receive the write-capable token.
GITHUB_READ_TOKEN=

# --- Daytona ---
DAYTONA_API_KEY=
DAYTONA_SNAPSHOT=openthrottle
# Sandbox resource sizing, applied when the snapshot is built
# (supervisor/scripts/build-snapshot.mjs). Defaults clear Daytona's small
# default tier, which OOM-kills real pnpm/Turbo monorepo builds (exit 137).
# cpu in cores, memory/disk in GiB. Disk is kept small because Daytona
# enforces a 30 GiB *total* org disk quota and OpenThrottle retains a stopped
# sandbox per non-closed ticket; raise it only on a plan with a larger quota.
DAYTONA_SANDBOX_CPU=4
DAYTONA_SANDBOX_MEMORY=8
DAYTONA_SANDBOX_DISK=10

# --- Engine credentials (only the selected engine is materialized) ---
CLAUDE_CODE_OAUTH_TOKEN=
# Raw contents of ~/.codex/auth.json, as a single-line JSON string
CODEX_AUTH_JSON=
# Kimi Code Console subscription API key for OpenCode (not Kimi Open Platform)
KIMI_CODE_API_KEY=

# --- Execution kernel ---
TASK_TIMEOUT=7200
WEBHOOK_MAX_AGE_SECONDS=60
OT_KERNEL_WORKER_ID=supervisor-primary
OT_KERNEL_WORKER_INTERVAL_MS=1000
OT_KERNEL_LEASE_SECONDS=120
OT_KERNEL_CYCLE_LIMIT=16
