# OpenThrottle supervisor — environment variables.
# See docs/SPEC.md "Supervisor contract > Supervisor env" for the authoritative list.
# Copy to .env for local dev (tsx/dotenv is NOT wired in automatically —
# export these into your shell, or use `dotenv -e .env -- npm run dev`).

# --- HTTP / storage ---
PORT=8080
DATABASE_PATH=/data/openthrottle.db
SUPERVISOR_URL=https://openthrottle-supervisor.fly.dev
OT_STATUS_TOKEN=
OT_INSTALL_SECRET=

# --- Linear (webhook + OAuth app, actor=app) ---
LINEAR_WEBHOOK_SECRET=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# --- GitHub ---
GITHUB_WEBHOOK_SECRET=
# Fine-grained PAT: administration/webhooks rw, contents rw, PRs rw,
# checks/actions read, with access to every target repository
GITHUB_TOKEN=
# Fallback for unmapped/legacy Linear teams. New targets use `openthrottle init`.
GITHUB_REPO=owner/name
# Legacy optional JSON fallback: {"linear-team-id":"owner/repo","TEAM":"owner/repo"}
GITHUB_REPO_MAPPINGS=
# Optional JSON: {"Repo/web-app":"owner/web-app","Repo › Repo/api":"owner/api"}
GITHUB_REPO_LABEL_MAPPINGS=
# Optional git commit-author override for sandbox commits. Leave blank to author
# commits as the GitHub account behind GITHUB_TOKEN (its noreply identity), which
# keeps commits attributable and accepted by author-gated integrations (Vercel).
OT_GIT_AUTHOR_NAME=
OT_GIT_AUTHOR_EMAIL=

# --- Daytona ---
DAYTONA_API_KEY=
DAYTONA_SNAPSHOT=openthrottle
# Sandbox resource sizing, applied when the snapshot is built
# (supervisor/scripts/build-snapshot.mjs). Defaults clear Daytona's small
# default tier, which OOM-kills real pnpm/Turbo monorepo builds (exit 137).
# cpu in cores, memory/disk in GiB. Disk is kept small because Daytona
# enforces a 30 GiB *total* org disk quota and OpenThrottle retains a stopped
# sandbox per non-closed ticket; raise it only on a plan with a larger quota.
DAYTONA_SANDBOX_CPU=4
DAYTONA_SANDBOX_MEMORY=8
DAYTONA_SANDBOX_DISK=5

# --- Agent subscription auth ---
DEFAULT_AGENT=codex
CLAUDE_CODE_OAUTH_TOKEN=
# Raw contents of ~/.codex/auth.json, as a single-line JSON string
CODEX_AUTH_JSON=
# Kimi Code Console subscription API key for OpenCode (not Kimi Open Platform)
KIMI_CODE_API_KEY=

# --- Task defaults ---
# Fallback for unmapped/legacy Linear teams. Registered targets persist their own base branch.
BASE_BRANCH=main
MAX_TURNS=200
TASK_TIMEOUT=7200
CALLBACK_GRACE_SECONDS=120
DEV_PORT=3000
SWEEP_MAX_AGE_DAYS=14
ORPHAN_GRACE_MINUTES=5
WEBHOOK_MAX_AGE_SECONDS=60
REVIEW_MAX_ROUNDS=3
# Optional: posted on the PR after a feedback-triggered resume completes
# cleanly, to nudge an external reviewer bot/human to re-review (e.g.
# "@codex review"). Empty (default) relies on the bot's own review-on-push
# behavior.
REVIEW_NUDGE_COMMENT=
ALLOW_LINEAR_MERGE=false
SANDBOX_EVENT_POLL_INTERVAL_MS=5000
# Liveness cap (seconds): a running run that emits no sandbox activity — not
# even the throttled heartbeat from runner/normalize.mjs — for this long is
# reaped (failed + sandbox idled), independent of the hard TASK_TIMEOUT wall
# clock. Must be >= 60; keep it comfortably above the heartbeat interval.
STALL_TIMEOUT_SECONDS=900
# Admission kill switch. False affects future generations only; already-pinned
# pipeline generations retain their mode.
PIPELINE_COORDINATOR_ENABLED=false
# Optional comma-separated canary cohort. Empty means all routed repos when
# the kill switch is enabled.
PIPELINE_COORDINATOR_REPOSITORIES=
