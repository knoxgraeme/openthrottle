{
  "schema": "openthrottle.graph/v1",
  "id": "structured",
  "version": 1,
  "entry_node": "implement",
  "workers": [
    {
      "id": "implementer",
      "engine": "agent",
      "session_scope": "attempt",
      "credentials": [
        "repo.read"
      ],
      "skills": [
        "repo://owner/repo@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa#../../.github/workflows/ci.yml"
      ]
    }
  ],
  "loops": [
    {
      "id": "unit_loop",
      "worker": "implementer",
      "input_scope": "unit",
      "receipt": "unit_completion",
      "max_parallel": 1,
      "max_rounds": 2,
      "skill": "repo://owner/repo@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa#../../.github/workflows/ci.yml",
      "timeout_seconds": 3600
    }
  ],
  "nodes": [
    {
      "id": "implement",
      "kind": "for_each_unit",
      "phases": [
        { "id": "implement", "kind": "agent", "loop": "unit_loop" },
        { "id": "candidate", "kind": "evidence" },
        { "id": "lead", "kind": "gate", "loop": "unit_loop" },
        { "id": "integrate", "kind": "integrate" }
      ],
      "depends_on": [],
      "transitions": {
        "success": {
          "terminal": "completed"
        }
      }
    }
  ]
}
